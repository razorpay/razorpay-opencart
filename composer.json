{
    "name": "razorpay/opencart-extension",
    "description": "Razorpay Payment Extension for OpenCart - Unit Tests",
    "type": "opencart-extension",
    "license": "MIT",
    "require": {
        "php": ">=7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite 'Unit Tests'",
        "test:integration": "phpunit --testsuite 'Integration Tests'",
        "test:coverage": "phpunit --coverage-html tests/coverage",
        "phpstan": "phpstan analyse admin catalog --level=5",
        "cs": "phpcs --standard=PSR12 admin catalog",
        "cs:fix": "phpcbf --standard=PSR12 admin catalog"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
